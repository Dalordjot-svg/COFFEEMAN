# demo runs with independent sample data in this browser.
VITE_APP_MODE=demo
# Change to firebase only with an explicitly configured database and deployed gateway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# Emulator only. Accepted values: localhost, 127.0.0.1.
VITE_FIREBASE_EMULATOR_HOST=
