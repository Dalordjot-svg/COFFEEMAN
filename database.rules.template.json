        ".read": "auth != null && (auth.token.coffeemanRole === 'waiter' || auth.token.coffeemanRole === 'admin') && root.child('coffeeman').child('users').child(auth.uid).child('active').val() === true && root.child('coffeeman').child('users').child(auth.uid).child('role').val() === auth.token.coffeemanRole",
