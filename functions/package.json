{
  "name": "coffeeman-firebase-functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.cjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --packages=external --outfile=lib/index.cjs",
    "test:emulator": "node --test test/emulator.test.mjs",
    "account": "node scripts/provision-account.mjs",
    "test:emulator:browser": "node --test test/browser.test.mjs"
  },
  "dependencies": {
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
